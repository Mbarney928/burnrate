# Copy to .env and adjust. burnrate needs no secrets in its environment: API tokens are
# created with `burnrate token create` and only their hashes are stored in the database.

# host:port to listen on (127.0.0.1 keeps it local; Docker sets 0.0.0.0 inside the container)
BURNRATE_ADDR=127.0.0.1:8080
# SQLite database file (gitignored)
BURNRATE_DB_PATH=burnrate.db
# debug | info | warn | error
BURNRATE_LOG_LEVEL=info
# Per-client-IP request rate limit
BURNRATE_RATE_LIMIT_RPS=20
BURNRATE_RATE_LIMIT_BURST=40
# Failed authentication attempts allowed per client IP per minute
BURNRATE_AUTH_FAILURES_PER_MINUTE=10
